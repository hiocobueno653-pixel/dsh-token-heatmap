{
  "name": "dsh-token-heatmap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "每日 Token 消耗热力图：六档深浅配色，点格子看当天用量明细（只读扫描本地会话日志）",
  "license": "MIT",
  "author": "hiocobueno653-pixel",
  "homepage": "https://github.com/hiocobueno653-pixel/dsh-token-heatmap#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiocobueno653-pixel/dsh-token-heatmap.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "token-usage",
    "heatmap"
  ],
  "main": "./src/cordis.js",
  "exports": {
    ".": "./src/cordis.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
